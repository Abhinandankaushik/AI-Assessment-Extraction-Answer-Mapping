# Required. Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional. Comma-separated fallback chain, tried left to right when a model
# hits its free-tier daily quota (429) or is overloaded (503).
# Leave unset to use exactly this default.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
